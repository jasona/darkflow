{
  "name": "darkflow-client",
  "version": "1.5.6",
  "description": "Darkwind game client powered by Darkflow",
  "main": "desktop/main.cjs",
  "author": {
    "name": "Jason Alexander",
    "email": "jason.alexander@gmail.com"
  },
  "desktopName": "Darkwind",
  "homepage": "https://play.darkwind.ai",
  "engines": {
    "node": "22.15.0",
    "npm": "10.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasona/darkflow.git"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:server:built": "node integration/production-server-check.mjs",
    "test:mcp": "npm ci --prefix mud-test-mcp && npm test --prefix mud-test-mcp",
    "desktop": "npm run desktop:prepare-client && electron .",
    "desktop:prepare-client": "npm run build",
    "desktop:smoke": "npm run desktop:prepare-client && electron . --smoke-test",
    "desktop:pack": "npm run desktop:prepare-client && electron-builder --dir --publish never && node desktop/validate-package.cjs dist/desktop",
    "desktop:smoke:packaged": "node desktop/run-packaged-smoke.cjs dist/desktop",
    "desktop:dist": "npm run desktop:prepare-client && electron-builder --publish never",
    "desktop:dist:mac": "npm run desktop:prepare-client && electron-builder --mac --publish never",
    "desktop:dist:win": "npm run desktop:prepare-client && electron-builder --win --publish never",
    "desktop:dist:linux": "npm run desktop:prepare-client && electron-builder --linux --publish never",
    "desktop:release:mac": "npm run desktop:prepare-client && electron-builder --mac --publish never --config.mac.identity=null --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "desktop:release:win": "npm run desktop:prepare-client && electron-builder --win --publish never",
    "desktop:release:linux": "npm run desktop:prepare-client && electron-builder --linux --publish never",
    "desktop:validate-release": "node desktop/validate-release.cjs",
    "desktop:steam": "npm run desktop:prepare-client && electron-builder --dir --publish never --config.extraMetadata.darkflowDistribution=steam",
    "desktop:steam:mac": "npm run desktop:prepare-client && electron-builder --mac --dir --universal --publish never --config.extraMetadata.darkflowDistribution=steam",
    "desktop:steam:win": "npm run desktop:prepare-client && electron-builder --win --dir --x64 --publish never --config.extraMetadata.darkflowDistribution=steam",
    "desktop:steam:linux": "npm run desktop:prepare-client && electron-builder --linux --dir --x64 --publish never --config.extraMetadata.darkflowDistribution=steam",
    "version:set": "node desktop/set-version.cjs",
    "dev": "node server.js --dev",
    "build": "vite build",
    "verify:bundle": "node scripts/verify-bundle-sentinel.mjs",
    "verify:client-artifact": "node scripts/verify-client-artifact.mjs",
    "postbuild": "node scripts/write-client-version.mjs && npm run verify:bundle && npm run verify:client-artifact",
    "typecheck": "ttsc --noEmit --project tsconfig.json && ttsc --noEmit --project tsconfig.node.json",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test --config playwright.production.config.ts --project=chromium",
    "test:transports": "npm run build && playwright test --config playwright.production.config.ts --project=transports",
    "lint": "eslint \"client/phase0/**/*.{js,ts,svelte}\" \"e2e/**/*.ts\" \"*.config.{mjs,ts}\"",
    "format": "prettier --write \"client/phase0/**/*.{js,ts,svelte}\" \"e2e/**/*.ts\" \"*.config.{mjs,ts}\" \"tsconfig*.json\"",
    "format:check": "prettier --check \"client/phase0/**/*.{js,ts,svelte}\" \"e2e/**/*.ts\" \"*.config.{mjs,ts}\" \"tsconfig*.json\""
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "howler": "2.2.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@ttsc/unplugin": "0.23.0",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "dockview": "7.0.4",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "ttsc": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "typia": "13.2.0",
    "vite": "8.1.5"
  },
  "build": {
    "appId": "ai.darkwind.game",
    "productName": "Darkwind",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "dist/client/**/*",
      "server.js",
      "package.json"
    ],
    "extraMetadata": {
      "darkflowDistribution": "direct"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jasona",
        "repo": "darkflow"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "electronUpdaterCompatibility": ">=2.16",
      "forceCodeSigning": false,
      "hardenedRuntime": false,
      "identity": null,
      "icon": "public/assets/brand/darkflow-icon-512.png",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "electronUpdaterCompatibility": ">=2.16",
      "forceCodeSigning": false,
      "icon": "public/assets/brand/darkflow-icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "category": "Game",
      "electronUpdaterCompatibility": ">=2.16",
      "executableName": "darkwind",
      "icon": "public/assets/brand/darkflow-icon-512.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
