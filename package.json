{
  "name": "darkflow-client",
  "version": "1.5.6",
  "description": "Darkwind game client powered by Darkflow",
  "main": "desktop/main.cjs",
  "author": {
    "name": "Jason Alexander",
    "email": "jason.alexander@gmail.com"
  },
  "desktopName": "Darkwind",
  "homepage": "https://play.darkwind.ai",
  "engines": {
    "node": ">=22.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasona/darkflow.git"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "desktop:pack": "electron-builder --dir --publish never",
    "desktop:dist": "electron-builder --publish never",
    "desktop:dist:mac": "electron-builder --mac --publish never",
    "desktop:dist:win": "electron-builder --win --publish never",
    "desktop:dist:linux": "electron-builder --linux --publish never",
    "desktop:release:mac": "electron-builder --mac --publish never --config.mac.identity=null --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "desktop:release:win": "electron-builder --win --publish never",
    "desktop:release:linux": "electron-builder --linux --publish never",
    "desktop:validate-release": "node desktop/validate-release.cjs",
    "desktop:steam": "electron-builder --dir --publish never --config.extraMetadata.darkflowDistribution=steam",
    "desktop:steam:mac": "electron-builder --mac --dir --universal --publish never --config.extraMetadata.darkflowDistribution=steam",
    "desktop:steam:win": "electron-builder --win --dir --x64 --publish never --config.extraMetadata.darkflowDistribution=steam",
    "desktop:steam:linux": "electron-builder --linux --dir --x64 --publish never --config.extraMetadata.darkflowDistribution=steam",
    "version:set": "node desktop/set-version.cjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "ttsc --noEmit --project tsconfig.json && ttsc --noEmit --project tsconfig.node.json",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "howler": "2.2.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.13.3",
    "@ttsc/unplugin": "0.23.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron-builder": "^26.15.3",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "ttsc": "0.23.0",
    "typia": "13.2.0",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  },
  "build": {
    "appId": "ai.darkwind.game",
    "productName": "Darkwind",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "extraMetadata": {
      "darkflowDistribution": "direct"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jasona",
        "repo": "darkflow"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "electronUpdaterCompatibility": ">=2.16",
      "forceCodeSigning": false,
      "hardenedRuntime": false,
      "identity": null,
      "icon": "public/assets/brand/darkflow-icon-512.png",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "electronUpdaterCompatibility": ">=2.16",
      "forceCodeSigning": false,
      "icon": "public/assets/brand/darkflow-icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "category": "Game",
      "electronUpdaterCompatibility": ">=2.16",
      "executableName": "darkwind",
      "icon": "public/assets/brand/darkflow-icon-512.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}