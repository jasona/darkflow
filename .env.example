# MUD Server Connection Defaults
MUD_HOST=your-mud-server.com
MUD_PORT=4242
MUD_WSS=1

# Game branding (shown in toolbar and page title before GMCP provides it)
GAME_NAME=My MUD

# Comma-separated panel IDs to hide by default (overrides built-in defaults).
# User can still re-open them via the Panels menu; choice is saved per-browser.
# Valid IDs: avatar, status, vitals, omens, buffs, worth, stats, room, group,
# inventory, enemy, chat, map, roomImage, quests, achievements
HIDDEN_PANELS=
